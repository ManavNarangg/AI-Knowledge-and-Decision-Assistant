# ---------------------------------------------------------------------------
# LLM provider (used only for question decomposition and answer writing).
# Set ONE key below. With LLM_PROVIDER=auto the first key found is used:
#   ANTHROPIC_API_KEY -> GROQ_API_KEY -> GEMINI_API_KEY
# Free options (no credit card):
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto            # auto | groq | gemini | ollama | anthropic | openai-compatible

GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides. Provider defaults: groq=llama-3.3-70b-versatile,
# gemini=gemini-flash-latest, ollama=qwen2.5:3b, anthropic=claude-opus-5
LLM_MODEL=
# Models tried when the main one is overloaded (free tiers often return 503/429).
# 'default' = provider preset (gemini-flash-lite-latest / llama-3.1-8b-instant); empty = no fallback.
LLM_FALLBACK_MODELS=default
# Model used to OCR scanned PDF pages (must accept images). Empty = same as LLM_MODEL.
# Needed with Groq, whose default text model can't read images.
LLM_VISION_MODEL=
# Only for LLM_PROVIDER=openai-compatible (e.g. OpenRouter) or a non-default Ollama host.
LLM_BASE_URL=
LLM_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of this server, used to build assistant URLs and embed code.
PUBLIC_BASE_URL=http://localhost:8000
# Where the SQLite database and uploaded PDFs are stored.
DATA_DIR=./data
# Set to true when serving over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false
